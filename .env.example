# Copy to .env.local and fill in.

# Generate with: npx @better-auth/cli secret   (or any 32+ random characters)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Leave empty for local development: the app then uses PGlite in .data/pglite.
# Set to a real Postgres connection string for staging and production.
DATABASE_URL=

# Outgoing email (reminders and invoices). Any SMTP provider works, e.g.
# smtps://user:password@smtp.example.com:465. Leave empty in development to save
# emails to .data/outbox instead. Required in production.
SMTP_URL=
EMAIL_FROM="Tiba <notes@yourpractice.com>"

# Shared secret for the reminder scheduler: call GET /api/cron/reminders hourly with
# "Authorization: Bearer <CRON_SECRET>". Generate any long random string.
CRON_SECRET=

# "Ask Tiba", the help assistant (Google Gemini API key from aistudio.google.com). It only sees
# Tiba's help guide and the question typed, never patient records. Without it the chat
# panel still opens but says the assistant isn't set up yet.
GEMINI_API_KEY=
# Optional: another Gemini model if Google retires the default (gemini-3.5-flash-lite).
GEMINI_MODEL=

# Looking up patients' home addresses on the map, so clock-ins can be checked (src/lib/geocode.ts).
# A Google Maps Platform key with the Geocoding API turned on. Without it Tiba uses OpenStreetMap's
# free Nominatim service, which has no HIPAA agreement: test data only.
GOOGLE_MAPS_API_KEY=
