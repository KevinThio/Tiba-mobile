# Copy to .env.local and fill in.

# Generate with: npx @better-auth/cli secret   (or any 32+ random characters)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Leave empty for local development: the app then uses PGlite in .data/pglite.
# Set to a real Postgres connection string for staging and production.
DATABASE_URL=
